<header>
  <div class="flexrow image-name-keywords">
    <img src="{{actor.img}}" alt="{{actor.name}}">
    <div class="flexcol name-keywords">
      <h2 class="name">
        <a data-action="openSheet">{{actor.name}}</a>
      </h2>
      <div class="keywords">
        {{retainerKeywords}}
      </div>
    </div>
  </div>
  <div class="flexcol level-ev">
    <div class="level">
      {{localize "DRAW_STEEL.Actor.npc.FIELDS.monster.level.label"}}
      {{system.level}}
      {{#if system.retainer.roleLabel}}
      {{system.retainer.roleLabel}}
      {{/if}}
      {{localize "TYPES.Actor.retainer" }}
    </div>
    <div class="ev">
      <br>
    </div>
  </div>
</header>

<section class="stats flexcol">
  <div class="basic-stats flexrow">
    <div class="size">
      {{system.combat.size}}
      <strong>{{systemFields.combat.fields.size.label}}</strong>
    </div>
    <div class="speed">
      {{system.movement.value}}
      <strong>{{localize "DRAW_STEEL.Actor.base.FIELDS.movement.value.label"}}</strong>
    </div>
    <div class="stamina">
      {{system.stamina.max}}
      <strong>{{systemFields.stamina.label}}</strong>
    </div>
    <div class="stability">
      {{system.combat.stability}}
      <strong>{{systemFields.combat.fields.stability.label}}</strong>
    </div>
    <div class="free-strike">
      {{system.monster.freeStrike}}
      <strong>{{systemFields.monster.fields.freeStrike.label}}</strong>
    </div>
  </div>

  <div class="secondary-stats">
    <div class="immunities">
      <span class="label">{{systemFields.damage.fields.immunities.label}}:</span>
      <span class="value">{{{ifThen damageIW.immunities damageIW.immunities "—"}}}</span>
    </div>
    <div class="weakness">
      <span class="label">{{systemFields.damage.fields.weaknesses.label}}:</span>
      <span class="value">{{{ifThen damageIW.weaknesses damageIW.weaknesses "—"}}}</span>
    </div>
    <div class="movement">
      <span class="label">{{systemFields.movement.label}}:</span>
      <span class="value">{{ifThen movement movement "—"}}</span>
    </div>
  </div>

  <div class="characteristics">
    {{#each characteristics as |chr key|}}
    <div class="characteristic">
      <div class="label">
        {{chr.field.label}}
      </div>
      <div class="value">
        {{numberFormat chr.value sign=true}}
      </div>
    </div>
    {{/each}}
  </div>

  <ul class="item-embed-list">
    {{#each itemEmbeds as |item|}}
    <li class="{{item.icon}}">{{{item.outerHTML}}}</li>
    {{/each}}
  </ul>   
</section>
<section>
  <hr>
  {{#each advancementEmbeds as |item|}}
  <div class="advancement-level">
    <div>
      <h3>
        {{localize "DRAW_STEEL.Actor.npc.FIELDS.monster.level.label"}} {{item.level}} {{localize "TYPES.Actor.retainer" }} {{localize "DOCUMENT.Advancement"}} 
      </h3>
    </div>
  </div>
  <div>
    <ul class="item-embed-list advancement">
      <li class="{{item.ability.icon}}">{{{item.ability.outerHTML}}}</li>
    </ul>
    <hr>
  </div>
  {{/each}}
</section>
